{
  "name": "edutoy-yanji",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "generate:api": "../backend/.venv/bin/python ../backend/scripts/export_openapi.py && openapi-typescript ../backend/openapi.json -o src/api.generated.ts && prettier --write src/api.generated.ts",
    "format:check": "prettier --check src e2e *.ts *.json index.html",
    "format": "prettier --write src e2e *.ts *.json index.html"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/react-query": "^5.0.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
